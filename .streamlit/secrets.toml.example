# Copie este arquivo para .streamlit/secrets.toml e preencha.
# No Streamlit Cloud, cole o mesmo conteúdo em: App > Settings > Secrets.
# O secrets.toml NUNCA deve ir para o GitHub (já está no .gitignore).

[app]
# Opcional: seu WhatsApp com DDI e DDD, só números.
# Se preferir, preencha WHATSAPP_PADRAO no início do app.py e apague esta seção.
# whatsapp = "5521999999999"

[planilha]
# O ID é o trecho entre /d/ e /edit no link da planilha
id = "COLE_AQUI_O_ID_DA_PLANILHA"
aba = "Leads"

# Gere este bloco com:  python ferramentas/json_para_secrets.py caminho/da/chave.json
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
